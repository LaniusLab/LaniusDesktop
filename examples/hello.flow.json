{
  "schemaVersion": 1,
  "id": "flow_01J8ZHELLO000000000000001",
  "name": "你好，Lanius",
  "description": "最小示例流程：记录日志、等待、再记录日志。",
  "variables": {
    "who": { "type": "string", "default": "世界" }
  },
  "settings": {
    "timeoutMs": 60000,
    "onError": "stop"
  },
  "nodes": [
    {
      "id": "say_hello",
      "type": "core.log",
      "label": "记录问候",
      "position": { "x": 80, "y": 120 },
      "config": { "message": "你好，{{ who }}！", "level": "info" }
    },
    {
      "id": "wait_a_bit",
      "type": "core.wait",
      "label": "稍等片刻",
      "position": { "x": 360, "y": 120 },
      "config": { "ms": 200 }
    },
    {
      "id": "say_bye",
      "type": "core.log",
      "label": "记录告别",
      "position": { "x": 640, "y": 120 },
      "config": { "message": "执行完毕", "level": "info" }
    }
  ],
  "edges": [
    { "id": "e1", "from": "say_hello", "to": "wait_a_bit", "kind": "control" },
    { "id": "e2", "from": "wait_a_bit", "to": "say_bye", "kind": "control" }
  ],
  "metadata": { "createdWith": "0.1.0", "tags": ["example"] }
}
