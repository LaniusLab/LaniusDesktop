{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lanius.dev/schemas/shell-secret.schema.json",
  "title": "SecretListResult",
  "description": "壳层凭据：值只进系统 keyring；UI 仅见名称列表（SECURITY.md §3）。引用格式 secret://<name>。",
  "type": "object",
  "required": ["keys"],
  "properties": {
    "keys": {
      "type": "array",
      "items": { "$ref": "#/$defs/secretName" },
      "description": "已登记凭据名（不含 secret:// 前缀，永不含值）"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "secretName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "凭据名；流程里写 secret://<name>"
    },
    "secretSetParams": {
      "type": "object",
      "required": ["key", "value"],
      "properties": {
        "key": { "$ref": "#/$defs/secretName" },
        "value": { "type": "string", "minLength": 1, "description": "明文仅经 invoke 传入，不落盘、不进日志" }
      },
      "additionalProperties": false
    },
    "secretGetParams": {
      "type": "object",
      "required": ["key"],
      "properties": {
        "key": { "$ref": "#/$defs/secretName" }
      },
      "additionalProperties": false
    },
    "secretDeleteParams": {
      "type": "object",
      "required": ["key"],
      "properties": {
        "key": { "$ref": "#/$defs/secretName" }
      },
      "additionalProperties": false
    },
    "secretSetResult": {
      "type": "object",
      "required": ["key"],
      "properties": {
        "key": { "$ref": "#/$defs/secretName" }
      },
      "additionalProperties": false
    },
    "secretGetResult": {
      "type": "object",
      "required": ["key", "found"],
      "properties": {
        "key": { "$ref": "#/$defs/secretName" },
        "found": { "type": "boolean" },
        "value": {
          "type": ["string", "null"],
          "description": "仅供引擎回调；UI 凭据页禁止调用后展示"
        }
      },
      "additionalProperties": false
    },
    "secretDeleteResult": {
      "type": "object",
      "required": ["key", "removed"],
      "properties": {
        "key": { "$ref": "#/$defs/secretName" },
        "removed": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
