{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lanius.dev/schemas/flow.schema.json",
  "title": "FlowFile",
  "description": "Lanius 流程文件（docs/FLOW-FORMAT.md）",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "nodes", "edges"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "variables": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/variable" }
    },
    "settings": { "$ref": "#/$defs/settings" },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "metadata": { "type": "object" }
  },
  "$defs": {
    "variable": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["string", "number", "boolean"] },
        "default": true
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "timeoutMs": { "type": "integer", "exclusiveMinimum": 0, "default": 600000 },
        "onError": { "type": "string", "default": "stop" }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "nodeVersion": { "type": "integer", "minimum": 1, "default": 1 },
        "label": { "type": "string" },
        "position": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          }
        },
        "config": { "type": "object" },
        "inputs": { "type": "object" },
        "disabled": { "type": "boolean", "default": false }
      }
    },
    "edge": {
      "type": "object",
      "required": ["id", "from", "to"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["control"], "default": "control" },
        "branch": { "type": "string" }
      }
    }
  }
}
