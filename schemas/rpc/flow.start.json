{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lanius.dev/schemas/rpc/flow.start.json",
  "title": "flow.start",
  "description": "立即返回 executionId；进度经通知；终态查 execution.get",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "flow": { "type": "object" },
        "path": { "type": "string" },
        "mode": { "type": "string", "enum": ["run", "dryRun"] },
        "inputs": { "type": "object" }
      },
      "additionalProperties": true
    },
    "result": {
      "type": "object",
      "required": ["executionId"],
      "properties": {
        "executionId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
